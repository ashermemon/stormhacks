# Caddy obtains and renews the TLS certificate automatically. It serves the built
# frontend straight from disk and proxies only the websocket (/ws) to the game server,
# so big asset downloads never occupy the Python event loop.
otternonsense.tech, www.otternonsense.tech {
	# Text and model files shrink well; PNGs are already compressed, so skip them.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
			header Content-Type model/*
			header Content-Type application/octet-stream*
		}
	}

	handle /ws {
		reverse_proxy 127.0.0.1:8765
	}

	handle {
		root * /opt/stormhacks/frontend/dist

		# Vite fingerprints everything in /assets, so it can be cached forever;
		# index.html must be revalidated so a deploy is picked up.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@entry path / /index.html
		header @entry Cache-Control "no-cache"

		file_server
	}
}
